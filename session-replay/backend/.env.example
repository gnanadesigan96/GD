PORT=3001
CORS_ORIGIN=https://your-app.example.com

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Option A (local dev): paste the full connection string from Azure Portal
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Option B (production on AKS with Workload Identity — recommended):
# Leave AZURE_STORAGE_CONNECTION_STRING blank and set these instead:
AZURE_STORAGE_ACCOUNT=yourstorageaccount
# AZURE_STORAGE_KEY=   ← only needed if NOT using Workload Identity
AZURE_STORAGE_CONTAINER=session-replay
