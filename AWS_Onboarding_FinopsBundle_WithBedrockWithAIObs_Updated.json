								"bedrock:ListAgentActionGroups",
								"bedrock:GetAgentActionGroup",
								"bedrock:ListAgentKnowledgeBases",
								"bedrock:GetKnowledgeBase"
							],
							"Resource": "*"
						}
					]
				},
				"Roles": [
					{
						"Ref": "Role"
					}
				]
			}
		},
		"FinOpsForAICloudWatchLogsPolicy": {
			"Type": "AWS::IAM::Policy",
			"Condition": "IncludeFinOpsForAI",
			"Properties": {
				"PolicyName": "CoreStack_FinOpsForAI_CloudWatchLogs",
				"PolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Sid": "CoreStackCloudWatchLogsReadOnly",
							"Effect": "Allow",
							"Action": [
								"logs:DescribeLogGroups",
								"logs:DescribeLogStreams",
								"logs:FilterLogEvents",
								"logs:StartQuery",
								"logs:GetQueryResults",
								"logs:StopQuery"
							],
							"Resource": "*"
						}
					]
				},
				"Roles": [
					{
						"Ref": "Role"
					}
				]
			}
		},
		"FinOpsForAIIAMPolicy": {
			"Type": "AWS::IAM::Policy",
			"Condition": "IncludeFinOpsForAI",
			"Properties": {
				"PolicyName": "CoreStack_FinOpsForAI_IAM",
				"PolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Sid": "CoreStackIAMReadOnly",
							"Effect": "Allow",
							"Action": [
								"iam:ListRoles",
								"iam:GetRole"
							],
							"Resource": "*"
						}
					]
				},
				"Roles": [
					{
						"Ref": "Role"
					}
				]
			}
		},
		"FinOpsForAIAPIGatewayPolicy": {
			"Type": "AWS::IAM::Policy",
			"Condition": "IncludeFinOpsForAI",
			"Properties": {
				"PolicyName": "CoreStack_FinOpsForAI_APIGateway",
				"PolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Sid": "CoreStackAPIGatewayReadOnly",
							"Effect": "Allow",
							"Action": [
								"apigateway:GET"
							],
							"Resource": "*"
