								"bedrock:ListTagsForResource"
							],
							"Resource": "*"
						}
					]
				},
				"Roles": [
					{
						"Ref": "Role"
					}
				]
			}
		},
		"FinOpsForAIBedrockPolicy": {
			"Type": "AWS::IAM::Policy",
			"Condition": "IncludeFinOpsForAI",
