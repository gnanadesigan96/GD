# Copy to .env (which is gitignored) and fill in real values, or set these
# as real environment variables / secrets in your deployment. Never commit
# actual keys.
#
# This is the IAM identity that calls sts:AssumeRole on the customer's role
# -- it must be a principal the customer's role trust policy allows, paired
# with the ExternalId supplied per-request. If left unset, the backend falls
# back to boto3's default credential chain (instance/task role, etc.), which
# is preferable to static keys wherever that's available.
CUR_DASHBOARD_CALLER_ACCESS_KEY_ID=
CUR_DASHBOARD_CALLER_SECRET_ACCESS_KEY=
CUR_DASHBOARD_STS_REGION=us-east-1
