# Copy to .env (which is gitignored) and fill in real values, or set these
# as real environment variables / secrets in your deployment. Never commit
# actual keys.
#
# This is the IAM identity that calls sts:AssumeRole on the customer's role
# -- it must be a principal the customer's role trust policy allows, paired
# with the ExternalId supplied per-request.
#
# Preferred: put the access key / secret key in Azure Key Vault and point
# app/secrets.py at it (edit the placeholders there, or set the three
# AZURE_* vars below instead) -- the vars in this file are only used as a
# fallback when no vault is configured, and boto3's default credential
# chain (instance/task role, etc.) is used if neither is set.
AZURE_KEY_VAULT_URL=
AZURE_KV_ACCESS_KEY_SECRET_NAME=
AZURE_KV_SECRET_KEY_SECRET_NAME=

CUR_DASHBOARD_CALLER_ACCESS_KEY_ID=
CUR_DASHBOARD_CALLER_SECRET_ACCESS_KEY=
CUR_DASHBOARD_STS_REGION=us-east-1

# Shared secret the frontend sends as x-api-key; requests without a match
# are rejected. Left unset, the check is skipped -- fine for local dev.
CUR_DASHBOARD_API_KEY=

# DynamoDB table used to track async CUR-load jobs in production (see
# app/jobs.py) -- deploy/deploy_backend.sh creates this and sets it on the
# Lambda automatically. Leave unset for local/uvicorn dev: without it,
# jobs.py falls back to a plain in-process dict, and main.py runs each job
# inline instead of firing a separate Lambda invocation, so nothing needs
# to survive across processes.
CUR_DASHBOARD_JOBS_TABLE=
