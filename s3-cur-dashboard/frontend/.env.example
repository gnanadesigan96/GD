# Copy to .env.production (gitignored) before building for deployment.
# Left empty, the dev server proxies /api to localhost:8000 instead (see
# vite.config.ts) and no API key header is sent.
#
# VITE_API_BASE_URL is normally left empty in production too: the deployed
# frontend and API share one CloudFront distribution (frontend at /, API at
# /api/*), so calls are same-origin. Only set it if the API lives on a
# different origin than the frontend.

VITE_API_BASE_URL=
VITE_API_KEY=
