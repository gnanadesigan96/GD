# Anthropic API key, used to tailor your resume + cover letter to each job.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Adzuna covers India + several European countries.
# Free signup at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble covers a much wider set of countries, including UAE (Dubai).
# Free signup at https://jooble.org/api/about
JOOBLE_API_KEY=

# Where the sqlite database, uploaded resumes and generated documents live.
DATA_DIR=./data
